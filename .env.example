# Copy to .env and fill in. Never commit a real .env.
# Database (overridden by docker-compose for the api service)
DATABASE_URL=postgresql+asyncpg://rakazo:rakazo@localhost:5432/rakazo

# JWT signing secret — set a long random value in production
JWT_SECRET=change-me-to-a-long-random-secret

# Fernet key for encrypting stored provider API keys.
# Leave empty to auto-generate on first boot (persisted to FERNET_KEY_FILE).
RAKAZO_FERNET_KEY=
FERNET_KEY_FILE=/data/.fernet_key

# CORS: "*" for local dev, or comma-separated origins
CORS_ORIGINS=*

# Agent loop tuning
MAX_AGENT_ITERATIONS=25
HELPER_MAX_ITERATIONS=8
APPROVAL_TIMEOUT_SECONDS=900
